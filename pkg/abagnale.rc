#!/bin/ksh

daemon="${TRUEPREFIX}/bin/abagnale"
daemon_user="_abagnale"
daemon_flags="-v -p /var/abagnale/plots"
daemon_timeout=300

. /etc/rc.d/rc.subr

rc_reload=NO

rc_configtest() {
	# use rc_exec here since daemon_flags may contain arguments with spaces
	rc_exec "${daemon} -n ${daemon_flags}"
}

rc_cmd $1
