#PGPASSFILE=/etc/abagnale/abagnale.pgpass
#PGSERVICEFILE=/etc/abagnale/abagnale.pgservice
#ABAG_CONFIG_FILE=/etc/abagnale/abagnale.conf
#ABAG_DATABASE_TARGET=ABAGNALE
#ABAG_DATABASE_USER=abagnale
#ABAG_HTTP_TIMEOUT_MILLIS=60000
#ABAG_THREAD_TIMEOUT_MILLIS=120500
#CDP_REST_URI=https://api.coinbase.com
#CDP_WS_URI=wss://advanced-trade-ws.coinbase.com
#CDP_ACCOUNT_PATH=/api/v3/brokerage/accounts/
#CDP_ACCOUNTS_PATH=/api/v3/brokerage/accounts
#CDP_FEES_PATH=/api/v3/brokerage/transaction_summary
#CDP_ORDER_PATH=/api/v3/brokerage/orders/historical/
#CDP_ORDER_CANCEL_PATH=/api/v3/brokerage/orders/batch_cancel
#CDP_ORDER_CREATE_PATH=/api/v3/brokerage/orders
#CDP_PRODUCTS_PATH=/api/v3/brokerage/products
#CDP_HTTP_REQUESTS_PER_SECOND=30
#CDP_HTTP_RETRY_SECONDS=3
#CDP_HTTP_STALL_MILLIS=3600000
#BITVAVO_REST_URI=https://api.bitvavo.com
#BITVAVO_WS_URI=wss://ws.bitvavo.com
#BITVAVO_WS_PATH=/v2
#BITVAVO_WS_AUTHENTICATE_PATH=/v2/websocket
#BITVAVO_ACCOUNTS_PATH=/v2/balance
#BITVAVO_FEES_PATH=/v2/account/fees
#BITVAVO_MARKETS_PATH=/v2/markets
#BITVAVO_ORDER_PATH=/v2/order
#BITVAVO_ORDER_CREATE_PATH=/v2/order
#BITVAVO_ORDER_CANCEL_PATH=/v2/order
#BITVAVO_REQUESTS_PER_SECOND=16
#BITVAVO_WS_STALL_MILLIS=3600000
#BITVAVO_WS_RETRY_SECONDS=3

abagnale:\
	:datasize=8G:\
	:openfiles=2048:\
	:setenv=LC_CTYPE=C.UTF-8:\
	:umask=0027:\
	:tc=daemon:
